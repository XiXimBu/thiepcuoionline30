{
  "version": 2,
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.+\\.(js|css))$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.+\\.(js|css|map|png|jpe?g|gif|svg|ico|webp|mp3|woff2?|txt))$",
      "dest": "/$1"
    },
    {
      "src": "/tao-link(?:\\.html)?/?",
      "dest": "/tao-link.html"
    },
    {
      "src": "/.*",
      "dest": "/api/page"
    }
  ]
}
